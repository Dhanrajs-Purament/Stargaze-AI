<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Base theme used only for the launch window; all real UI is Compose (StarGazeTheme).
      Translucent system bars so the Compose edge-to-edge content draws underneath them.
    -->
    <style name="Theme.StarGazeAI" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/space_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
